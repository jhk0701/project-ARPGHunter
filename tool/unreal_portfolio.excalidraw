    {
      "id": "9c0LS-fTAKWgt04aKrI1Y",
      "type": "text",
      "x": -2903.485137581209,
      "y": 1901.6944494574789,
      "width": 419.3756103515625,
      "height": 140,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
