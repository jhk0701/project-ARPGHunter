    {
      "id": "USyOG5FcofG5MoSUgzrNS",
      "type": "text",
      "x": -3485.7153236597146,
      "y": 340.22155836560006,
      "width": 314.191650390625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "#b2f2bb",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c02J",
      "roundness": null,
      "seed": 392438309,
      "version": 1481,
      "versionNonce": 44182022,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1769484585033,
      "link": null,
      "locked": false,
      "text": "버프, 디버프 구체적인 동작 내용 -> 추상화\n- 리소스 회복 : 이 버프를 갖고 있는 동안\n- 적에게 피해 : 이 버프를 갖고 있는 동안\n- 버프 : 이 버프를 갖고 있는 동안, 발동\n- 회피 : 무적 : 이 버프를 얻었을 때 피격 시, 발동",
      "fontSize": 16,
      "fontFamily": 6,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "버프, 디버프 구체적인 동작 내용 -> 추상화\n- 리소스 회복 : 이 버프를 갖고 있는 동안\n- 적에게 피해 : 이 버프를 갖고 있는 동안\n- 버프 : 이 버프를 갖고 있는 동안, 발동\n- 회피 : 무적 : 이 버프를 얻었을 때 피격 시, 발동",
      "autoResize": true,
      "lineHeight": 1.25
    },
