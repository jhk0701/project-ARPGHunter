    {
      "id": "e2CCFkI2gPIZSA4XAdW48",
      "type": "text",
      "x": -5604.096871943399,
      "y": 3320.9486680829496,
      "width": 565.2154541015625,
      "height": 120,
      "angle": 0,
      "strokeColor": "#868e96",
      "backgroundColor": "#b2f2bb",
